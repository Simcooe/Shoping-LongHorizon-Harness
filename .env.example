# ShopSimulator 环境地址（默认本机）
SHOPSIM_BASE_URL=http://127.0.0.1:5700

# DeepSeek 模型后端（dsh 的 llm-deepseek 适配器使用）
# 你的 DeepSeek API key。留空则 dsh 无法发起真实推理。
DEEPSEEK_API_KEY=

# 可选：覆盖 DeepSeek 官方 endpoint（默认 https://api.deepseek.com）
# 若走本地/代理，改成你的 base url。
DEEPSEEK_BASE_URL=

# 使用的模型 id（dsh 默认 catalog 支持 deepseek-v4-flash / deepseek-v4-pro）
DSH_MODEL=deepseek-v4-pro

# 单个 ShopSimulator 交互 HTTP 请求超时（毫秒）
SHOPSIM_TIMEOUT_MS=60000

# ── 评测侧模型配置 ──
# rubric 生成模型（Flash）
RUBRIC_MODEL=
RUBRIC_BASE_URL=
RUBRIC_API_KEY=
# Judge 模型（Pro）
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
